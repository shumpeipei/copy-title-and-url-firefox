{
  "manifest_version": 3,
  "name": "Copy Title and URL",
  "version": "1.0.0",
  "description": "開いているページのタイトルとURLをクリップボードにコピーします。",
  "browser_specific_settings": {
    "gecko": {
      "id": "copy-title-and-url@shumpeipei.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "activeTab",
    "clipboardWrite"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "タイトルとURLをコピー",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "タイトルとURLをコピー"
    }
  },
  "background": {
    "scripts": ["background.js"]
  }
}
